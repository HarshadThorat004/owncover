    "jsqr": "^1.4.0",
    "lucide-react": "^1.17.0",
    "next": "16.3.4",
    "next-auth": "^4.24.14",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "resend": "^6.18.1",
