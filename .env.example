# App
DATABASE_URL=
# Neon pooled URL for runtime. Unpooled URL for prisma migrate.
DIRECT_URL=
NEXTAUTH_URL=https://owncover.hvtx.in
NEXTAUTH_SECRET=
# Public site domain (used in client bundles + email defaults)
NEXT_PUBLIC_BRAND_DOMAIN=owncover.hvtx.in
# Google Search Console — URL-prefix property only (HTML tag method). Token only, not the full meta tag.
# Search Console → Add property → URL prefix → https://owncover.hvtx.in → HTML tag → copy content= value.
GOOGLE_SITE_VERIFICATION=
# Protects /api/cron/reminders and /api/cron/digest. Vercel sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Email (OTP + warranty reminders) via Resend free tier
# 1) Create API key at https://resend.com
# 2) Verify domain hvtx.in (SPF/DKIM) at https://resend.com/domains
# 3) From can be any address on that domain — no mailbox creation required
RESEND_API_KEY=
RESEND_FROM_EMAIL=OwnCover <noreply@owncover.hvtx.in>
RESEND_REPLY_TO=owncover.in@gmail.com
RESEND_TEST_RECIPIENT=owncover.in@gmail.com
# Optional buffer under Resend free 100/day cap (default 95)
RESEND_DAILY_LIMIT=95
# Optional inbound invoice forwarding (Resend Receiving)
# Put MX on inbound.owncover.hvtx.in only — do not change root hvtx.in mail.
INBOUND_EMAIL_DOMAIN=inbound.owncover.hvtx.in
RESEND_WEBHOOK_SECRET=


# Optional browser push (Settings → Browser alerts)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owncover.in@gmail.com

# Free Google Sign-In
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://owncover.hvtx.in/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional extra hosts for server OCR of uploaded images (comma-separated).
# UploadThing hosts are already allowed.
# ALLOWED_REMOTE_IMAGE_HOSTS=

UPLOADTHING_TOKEN=
