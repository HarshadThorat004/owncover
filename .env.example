# App
DATABASE_URL=
# Neon/Supabase pooled setups: unpooled URL for prisma migrate. Optional locally —
# `npm run build` derives it from DATABASE_URL by stripping `-pooler`.
DIRECT_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Protects /api/cron/reminders. Vercel sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Email (OTP + warranty reminders) via Resend free tier
# 1) Create API key at https://resend.com
# 2) Verify domain owncover.in (SPF/DKIM) at https://resend.com/domains
# 3) From can be any address on that domain — no mailbox creation required
RESEND_API_KEY=
RESEND_FROM_EMAIL=OwnCover <noreply@owncover.in>
RESEND_REPLY_TO=hello@owncover.in
RESEND_TEST_RECIPIENT=hello@owncover.in
# Optional buffer under Resend free 100/day cap (default 95)
RESEND_DAILY_LIMIT=95
# Optional inbound invoice forwarding (Resend Receiving)
# Put MX on inbound.owncover.in only — do not change root mail.
INBOUND_EMAIL_DOMAIN=inbound.owncover.in
RESEND_WEBHOOK_SECRET=


# Optional browser push (Settings → Browser alerts)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@owncover.in

# Free Google Sign-In
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — legacy vision OCR (disabled by default; hybrid scan is built-in)
GEMINI_API_KEY=
# OCR_USE_GEMINI=true
UPLOADTHING_TOKEN=
